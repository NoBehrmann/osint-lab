# Copy this file to secrets.properties and fill in your own values.
# secrets.properties is in .gitignore. Never commit it.
# Restart the app (run.cmd) after changing it.

# Instagram "sessionid" cookie, used by the Toutatis and Instagram Profile tools.
# 1. Log in to instagram.com in a browser, preferably with a secondary account
#    (Instagram may flag or lock accounts used for lookups).
# 2. DevTools (F12) > Application > Cookies > https://www.instagram.com > copy the value of "sessionid".
# 3. Paste it below (no quotes).
# You can also leave this empty and use the "Load from browser" button in the UI instead.
osintlab.instagram.sessionid=

# Optional GitHub token for the Code Platforms tool. Without one GitHub allows 60 requests/hour.
# Create a free fine-grained token with NO permissions at github.com/settings/personal-access-tokens
osintlab.github.token=
